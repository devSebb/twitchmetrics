{
  "name": "twitchmetrics",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "pnpm --filter @twitchmetrics/database exec prisma migrate dev",
    "db:seed": "pnpm --filter @twitchmetrics/database exec prisma db seed",
    "db:studio": "pnpm --filter @twitchmetrics/database studio",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "worker:migrate": "tsx workers/migrate-historical.ts",
    "worker:backfill-search": "tsx workers/backfill-search-data.ts",
    "worker:import-games": "tsx workers/import-games.ts",
    "worker:snapshot-scheduler": "tsx --env-file=apps/web/.env.local workers/snapshot-scheduler.ts",
    "worker:growth-rollup": "tsx --env-file=apps/web/.env.local workers/growth-rollup.ts",
    "worker:search-reindex": "tsx --env-file=apps/web/.env.local workers/search-reindex.ts",
    "worker:discover-social-links": "tsx --env-file=apps/web/.env.local workers/discover-social-links.ts",
    "worker:snapshot-youtube": "tsx --env-file=apps/web/.env.local workers/snapshot-youtube.ts",
    "worker:streamhatchet": "tsx --env-file=apps/web/.env.local workers/streamhatchet-ingest.ts",
    "worker:streamhatchet-link": "tsx --env-file=apps/web/.env.local workers/streamhatchet-link-identities.ts",
    "worker:streamhatchet-catalog": "tsx --env-file=apps/web/.env.local workers/streamhatchet-build-catalog.ts",
    "worker:streamhatchet-identity": "tsx --env-file=apps/web/.env.local workers/streamhatchet-resolve-identities.ts",
    "worker:streamhatchet-social": "tsx --env-file=apps/web/.env.local workers/streamhatchet-ingest-social-profiles.ts",
    "worker:cleanup-invalid-accounts": "tsx --env-file=apps/web/.env.local workers/cleanup-invalid-platform-accounts.ts",
    "worker:reconcile-visibility": "tsx --env-file=apps/web/.env.local workers/reconcile-creator-listing.ts",
    "worker:repair-visibility": "tsx --env-file=apps/web/.env.local workers/repair-creator-visibility.ts",
    "worker:purge-low-quality": "tsx --env-file=apps/web/.env.local workers/purge-low-quality-creators.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@prisma/client": "^6.2.0",
    "@types/pg": "^8.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "prisma": "^6.2.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "pg": "^8.20.0"
  }
}
