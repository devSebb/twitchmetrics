generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  creator
  talent_manager
  admin
}

enum ProfileState {
  unclaimed
  pending_claim
  claimed
  premium
}

enum Platform {
  twitch
  youtube
  instagram
  tiktok
  x
  kick
}

enum SnapshotTier {
  tier1
  tier2
  tier3
}

enum ClaimMethod {
  oauth
  cross_platform
  bio_challenge
  post_challenge
  manual_review
}

enum ClaimStatus {
  pending
  approved
  rejected
  expired
}

enum Vertical {
  gaming
  irl
  music
  creative
  sports
  other
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String?   @unique
  passwordHash           String?
  emailVerified          DateTime?
  name                   String?
  image                  String?
  role                   UserRole  @default(creator)
  roleSelectedAt         DateTime?
  suspended              Boolean   @default(false)
  hasCompletedOnboarding Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  creatorProfile       CreatorProfile?
  talentManagerProfile TalentManagerProfile?
  managedCreators      TalentManagerAccess[] @relation("ManagerToCreator")
  claimRequests        ClaimRequest[]
  auditLogs            AuditLog[]
}

// ============================================================
// TALENT MANAGER PROFILE
// ============================================================

model TalentManagerProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Semi-public — surfaced on /invite/roster
  agencyName String?
  bio        String? // app-layer max 280
  avatarUrl  String? // user-uploaded; canonical for TMs (no platform accounts)

  // PDF export branding
  brandColor String? // hex like "#E32C19"; null falls back to app brand red

  // Private — manager-only
  websiteUrl   String?
  country      String?
  languages    String[] @default([])
  contactEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  requestIpHash String?
  userAgentHash String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// CREATOR PROFILES
// ============================================================

model CreatorProfile {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?      @unique @db.Uuid
  user         User?        @relation(fields: [userId], references: [id])
  state        ProfileState @default(unclaimed)
  snapshotTier SnapshotTier @default(tier3)

  displayName String
  slug        String  @unique
  avatarUrl   String? // populated by enrichment from platform CDN
  customAvatarUrl String? // user-uploaded; last-resort fallback for creators with no platforms
  bannerUrl   String?
  bio         String?
  country     String?
  gender      String?
  language    String?
  age         Int?
  interests   Json    @default("[]")

  primaryPlatform Platform

  // Derived from recent stream snapshots (updated by enrichCreators)
  derivedLanguage String?
  primaryGameName String?
  primaryGameSlug String?
  lastStreamAt    DateTime?
  isActiveLast30d Boolean   @default(false)
  lastEnrichedAt  DateTime?

  totalFollowers BigInt  @default(0)
  totalViews     BigInt  @default(0)
  searchText     String? @default("")
  widgetConfig   Json    @default("[]")
  publicDemographicsEnabled Boolean @default(false)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastSnapshotAt      DateTime?
  lastLinkDiscoveryAt DateTime?
  claimedAt           DateTime?

  platformAccounts  PlatformAccount[]
  metricSnapshots   MetricSnapshot[]
  analytics         CreatorAnalytics[]
  claimRequests     ClaimRequest[]
  talentAccess      TalentManagerAccess[]
  brandPartnerships BrandPartnership[]
  growthRollups     CreatorGrowthRollup[]
  clips             CreatorClip[]
  streamSessions    StreamSessionFact[]

  @@index([state])
  @@index([snapshotTier])
  @@index([primaryPlatform])
  @@index([totalFollowers(sort: Desc)])
  @@index([derivedLanguage])
  @@index([primaryGameSlug])
  @@index([isActiveLast30d, totalFollowers(sort: Desc)])
}

model CreatorAnalytics {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId String         @db.Uuid
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  platform    Platform
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  estimatedMinutesWatched BigInt?
  averageViewDuration     Float?
  subscribersGained       Int?
  subscribersLost         Int?
  estimatedRevenue        Float?
  views                   BigInt?
  likes                   Int?
  comments                Int?
  shares                  Int?

  impressions   BigInt?
  reach         BigInt?
  profileViews  Int?
  websiteClicks Int?

  subscriberCount  Int?
  subscriberPoints Int?

  ageGenderData  Json?
  countryData    Json?
  deviceData     Json?
  trafficSources Json?

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorProfileId, platform, periodStart])
  @@index([creatorProfileId, platform])
  @@index([periodStart])
}

// ============================================================
// PLATFORM ACCOUNTS
// ============================================================

model PlatformAccount {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId String         @db.Uuid
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  platform            Platform
  platformUserId      String
  platformUsername    String
  platformDisplayName String?
  platformUrl         String?
  platformAvatarUrl   String?

  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  oauthScopes    String[]  @default([])

  isOAuthConnected Boolean   @default(false)
  lastOAuthRefresh DateTime?

  followerCount   BigInt?
  followingCount  BigInt?
  totalViews      BigInt?
  subscriberCount BigInt?
  postCount       Int?

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, platformUserId])
  @@unique([creatorProfileId, platform])
  @@index([platform])
  @@index([platformUsername])
}

// ============================================================
// METRIC SNAPSHOTS
// ============================================================

model MetricSnapshot {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId String         @db.Uuid
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  platform        Platform
  snapshotAt      DateTime @default(now())
  followerCount   BigInt?
  followingCount  BigInt?
  totalViews      BigInt?
  subscriberCount BigInt?
  postCount       Int?
  extendedMetrics Json?

  @@index([creatorProfileId, platform, snapshotAt])
  @@index([snapshotAt])
}

// ============================================================
// CLAIM REQUESTS
// ============================================================

model ClaimRequest {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId String         @db.Uuid
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id])

  method   ClaimMethod
  status   ClaimStatus @default(pending)
  platform Platform

  challengeCode      String?   @unique
  challengeExpiresAt DateTime?

  evidenceUrls String[]  @default([])
  reviewNotes  String?
  reviewedBy   String?   @db.Uuid
  reviewedAt   DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([creatorProfileId])
  @@index([userId])
  @@index([status])
}

// ============================================================
// TALENT MANAGER ACCESS
// ============================================================

enum RosterAccessStatus {
  pending
  active
  declined
}

model TalentManagerAccess {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  managerId        String         @db.Uuid
  manager          User           @relation("ManagerToCreator", fields: [managerId], references: [id])
  creatorProfileId String         @db.Uuid
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id])

  canViewAnalytics Boolean @default(true)
  canEditProfile   Boolean @default(false)
  canExportData    Boolean @default(false)
  canManageBrands  Boolean @default(false)

  // Invite-only state machine: every row starts pending. Only rosterInvite.accept can flip to active.
  status          RosterAccessStatus @default(pending)
  inviteTokenHash String?            @unique
  inviteExpiresAt DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?

  grantedAt DateTime  @default(now())
  grantedBy String    @db.Uuid
  revokedAt DateTime?

  @@unique([managerId, creatorProfileId])
  @@index([managerId])
  @@index([status, revokedAt])
  @@index([inviteExpiresAt])
}

// ============================================================
// BRAND PARTNERSHIPS
// ============================================================

model BrandPartnership {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId String         @db.Uuid
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  brandName    String
  brandLogoUrl String?
  campaignName String?
  startDate    DateTime?
  endDate      DateTime?
  isPublic     Boolean   @default(true)

  createdAt DateTime @default(now())
}

// ============================================================
// GAMES & CATEGORIES
// ============================================================

model Game {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  twitchGameId  String? @unique
  igdbId        Int?    @unique
  youtubeGameId String?

  name          String
  slug          String    @unique
  coverImageUrl String?
  summary       String?
  releaseDate   DateTime?
  genres        String[]  @default([])
  platforms     String[]  @default([])
  developer     String?
  publisher     String?

  searchText String? @default("")

  currentViewers  Int    @default(0)
  currentChannels Int    @default(0)
  peakViewers24h  Int    @default(0)
  avgViewers7d    Int    @default(0)
  avgLiveChannels Int    @default(0)
  hoursWatched7d  BigInt @default(0)

  vertical Vertical @default(gaming)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  viewerSnapshots    GameViewerSnapshot[]
  platformMappings   PlatformGameMapping[]
  platformSnapshots  GamePlatformViewerSnapshot[]
  broadcastLanguages GameBroadcastLanguage[]
  topChannels        GameTopChannel[]
  clips              GameClip[]

  @@index([currentViewers(sort: Desc)])
  @@index([name])
  @@index([vertical, currentViewers(sort: Desc)])
}

model PlatformGameMapping {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  gameId String @db.Uuid
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  platform         Platform
  platformGameId   String
  platformGameName String
  platformSlug     String?
  thumbnailUrl     String?
  tags             String[] @default([])

  source     String @default("api")
  confidence String @default("exact_name")

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platform, platformGameId])
  @@index([gameId, platform])
  @@index([platform, platformGameName])
}

model GameBroadcastLanguage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId    String   @db.Uuid
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  language  String
  label     String
  percent   Float
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([gameId, language])
  @@index([gameId])
}

model GameTopChannel {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId         String    @db.Uuid
  game           Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platform       Platform  @default(twitch)
  source         String    @default("api")
  platformUserId String?
  channelName    String
  avatarUrl      String?
  slug           String?
  streamTitle    String?
  language       String?
  startedAt      DateTime?
  category       String
  avgViewers     Int       @default(0)
  airtime        Int       @default(0)
  viewerHours    BigInt    @default(0)
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([gameId, platform, source, channelName])
  @@index([gameId, category])
  @@index([gameId, platform, category])
}

model GameClip {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId       String   @db.Uuid
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  clipId       String
  title        String
  thumbnailUrl String
  url          String
  viewCount    Int      @default(0)
  createdAt    DateTime
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([gameId, clipId])
  @@index([gameId])
}

model CreatorClip {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId String         @db.Uuid
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  clipId           String
  title            String
  thumbnailUrl     String
  url              String
  viewCount        Int            @default(0)
  duration         Float?
  gameName         String?
  language         String?
  createdAt        DateTime
  syncedAt         DateTime       @default(now()) @updatedAt

  @@unique([creatorProfileId, clipId])
  @@index([creatorProfileId, createdAt(sort: Desc)])
  @@index([creatorProfileId, viewCount(sort: Desc)])
}

model GameViewerSnapshot {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId String @db.Uuid
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  snapshotAt DateTime @default(now())

  twitchViewers   Int @default(0)
  twitchChannels  Int @default(0)
  youtubeViewers  Int @default(0)
  youtubeChannels Int @default(0)
  kickViewers     Int @default(0)
  kickChannels    Int @default(0)
  totalViewers    Int @default(0)
  totalChannels   Int @default(0)

  @@index([gameId, snapshotAt])
  @@index([snapshotAt])
}

model GamePlatformViewerSnapshot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  gameId String @db.Uuid
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  platform         Platform
  platformGameId   String?
  platformGameName String?

  snapshotAt      DateTime @default(now())
  bucketStartedAt DateTime

  viewers  Int
  channels Int?
  source   String @default("api")
  metadata Json?

  createdAt DateTime @default(now())

  @@unique([gameId, platform, source, bucketStartedAt])
  @@index([gameId, bucketStartedAt])
  @@index([platform, bucketStartedAt])
  @@index([platform, platformGameId])
}

// ============================================================
// EXTERNAL SESSION DATA
// ============================================================

model StreamHatchetSourceObject {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  bucket       String
  key          String
  etag         String?
  size         BigInt?
  lastModified DateTime?

  dataset       String    @default("daily_sessions_summary")
  platform      String?
  partitionDate DateTime? @db.Date

  status       String  @default("discovered")
  rowCount     Int?
  importedRows Int     @default(0)
  skippedRows  Int     @default(0)
  failedRows   Int     @default(0)
  errorSummary String?
  metadata     Json?

  lastImportedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  streamSessions StreamSessionFact[]

  @@unique([bucket, key])
  @@index([platform, partitionDate])
  @@index([status, updatedAt])
}

model StreamSessionFact {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  source         String                    @default("streamhatchet")
  sourceObjectId String                    @db.Uuid
  sourceObject   StreamHatchetSourceObject @relation(fields: [sourceObjectId], references: [id], onDelete: Cascade)

  creatorProfileId String?         @db.Uuid
  creatorProfile   CreatorProfile? @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)

  platform            String
  platformUserId      String
  platformVideoId     String?
  platformUsername    String
  platformDisplayName String?
  platformLogoUrl     String?
  country             String?

  partitionDate DateTime @db.Date

  streamBeginsAt DateTime
  streamEndsAt   DateTime
  peakViewersAt  DateTime?
  sessionTitle   String?   @db.Text

  primaryGameName String?
  allGameNames    String[] @default([])

  airtimeMinutes       Int
  minutesWatched       BigInt
  sessionViews         BigInt?
  averageViewers       Float
  averageViewersGlobal Float?
  peakViewers          Int

  share              Float?
  shareCrossPlatform Float?
  bestRank           Int?
  averageRank        Float?
  worstRank          Int?
  aggregation        String @default("basic")

  rawData      Json?
  contentLabel Json?
  rowHash      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, platform, platformUserId, streamBeginsAt, streamEndsAt])
  @@index([sourceObjectId])
  @@index([creatorProfileId, platform, partitionDate])
  @@index([platform, partitionDate])
  @@index([platform, primaryGameName, partitionDate])
  @@index([platformUserId, platform, partitionDate])
  @@index([rowHash])
}

model ChannelDailyRollup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  source           String   @default("streamhatchet")
  platform         String
  date             DateTime @db.Date
  creatorProfileId String?  @db.Uuid

  platformUserId      String
  platformUsername    String
  platformDisplayName String?
  platformLogoUrl     String?
  country             String?

  sessionCount   Int     @default(0)
  airtimeMinutes Int     @default(0)
  minutesWatched BigInt  @default(0)
  sessionViews   BigInt?

  averageViewers       Float?
  averageViewersGlobal Float?
  peakViewers          Int?
  peakViewersAt        DateTime?

  primaryGameName String?
  gameNames       String[]  @default([])
  bestRank        Int?
  averageRank     Float?
  worstRank       Int?
  lastStreamAt    DateTime?

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([source, platform, date, platformUserId])
  @@index([creatorProfileId, platform, date])
  @@index([platform, date, minutesWatched(sort: Desc)])
  @@index([platform, date, peakViewers(sort: Desc)])
}

model GameDailyRollup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  source   String   @default("streamhatchet")
  platform String
  date     DateTime @db.Date
  gameName String

  sessionCount   Int    @default(0)
  channelCount   Int    @default(0)
  airtimeMinutes Int    @default(0)
  minutesWatched BigInt @default(0)

  averageViewers Float?
  peakViewers    Int?

  topChannelUserId      String?
  topChannelUsername    String?
  topChannelDisplayName String?

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([source, platform, date, gameName])
  @@index([platform, date, minutesWatched(sort: Desc)])
  @@index([platform, gameName, date])
}

model ChannelGameDailyRollup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  source           String   @default("streamhatchet")
  platform         String
  date             DateTime @db.Date
  creatorProfileId String?  @db.Uuid

  platformUserId      String
  platformUsername    String
  platformDisplayName String?
  gameName            String

  sessionCount   Int    @default(0)
  airtimeMinutes Int    @default(0)
  minutesWatched BigInt @default(0)
  averageViewers Float?
  peakViewers    Int?

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([source, platform, date, platformUserId, gameName])
  @@index([creatorProfileId, platform, date])
  @@index([platform, date, gameName, minutesWatched(sort: Desc)])
}

// ============================================================
// REPORT TEMPLATES & PURCHASES
// ============================================================

enum ReportPurchaseStatus {
  pending
  paid
  failed
}

model ReportTemplate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  description  String
  slug         String   @unique
  config       Json
  priceInCents Int      @default(25000)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  purchases ReportPurchase[]
}

model ReportPurchase {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String
  name            String
  company         String?
  templateId      String               @db.Uuid
  template        ReportTemplate       @relation(fields: [templateId], references: [id])
  stripeSessionId String?              @unique
  status          ReportPurchaseStatus @default(pending)
  formData        Json

  createdAt DateTime @default(now())

  @@index([email])
  @@index([stripeSessionId])
  @@index([status])
}

// ============================================================
// REPORT LEADS
// ============================================================

model ReportLead {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String
  email   String
  company String
  details Json?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ============================================================
// CREATOR GROWTH ROLLUPS
// ============================================================

model CreatorGrowthRollup {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorProfileId String         @db.Uuid
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  platform Platform

  followerCount BigInt @default(0)
  delta1d       BigInt @default(0)
  delta7d       BigInt @default(0)
  delta30d      BigInt @default(0)
  pct1d         Float  @default(0)
  pct7d         Float  @default(0)
  pct30d        Float  @default(0)

  trendDirection String @default("FLAT")
  acceleration   String @default("STABLE")

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([creatorProfileId, platform])
  @@index([trendDirection])
  @@index([delta7d(sort: Desc)])
}

model IngestionRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domain         String
  scope          String
  jobType        String
  platform       String?
  status         String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  recordsScanned Int       @default(0)
  recordsWritten Int       @default(0)
  recordsSkipped Int       @default(0)
  recordsFailed  Int       @default(0)
  partialCount   Int       @default(0)
  quotaUsed      Int?
  errorSummary   String?
  metadata       Json?
  createdAt      DateTime  @default(now())

  @@index([jobType, startedAt(sort: Desc)])
  @@index([domain, scope, startedAt(sort: Desc)])
  @@index([platform, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  targetType String?
  targetId   String?  @db.Uuid
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
}
