# ============================================================
# DATABASE — Supabase PostgreSQL
# ============================================================
# Pooled connection via Supavisor (port 6543) — used for queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used for migrations only
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ============================================================
# SUPABASE — for Realtime features (future)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ============================================================
# AUTH — Auth.js v5 (NextAuth)
# ============================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # Generate: openssl rand -base64 32

# ============================================================
# RESEND — Transactional email delivery
# ============================================================
# Powers password-reset emails, magic-link sign-in, and the weekly
# digest worker. Create an API key at https://resend.com/api-keys
# (Sending access is sufficient). The from-addresses in code
# (noreply@twitchmetrics.net, hello@twitchmetrics.net) must be under a
# domain verified in Resend. Leave blank locally to disable email sending.
RESEND_API_KEY=""

# Inbox that receives internal alerts for CUSTOM report requests (the "quote"
# path). Defaults to sales@streamhatchet.com in code — set this only to
# override (e.g. route to your own inbox while testing).
REPORTS_NOTIFICATION_EMAIL=""

# ============================================================
# OAUTH PROVIDERS
# ============================================================

# Twitch — https://dev.twitch.tv/console
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_EVENTSUB_SECRET=""  # For webhook signature verification

# Google / YouTube — https://console.cloud.google.com
# Enable: YouTube Data API v3 + YouTube Analytics API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
YOUTUBE_API_KEY=""  # For public data fetching (no OAuth needed)

# Instagram / Meta — https://developers.facebook.com
# Requires: Instagram Graph API + Business account linked to Facebook Page
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# TikTok — https://developers.tiktok.com
# Requires: Login Kit + Display API approval
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# X / Twitter — https://developer.twitter.com
# Basic tier ($100/mo) minimum for read access
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_BEARER_TOKEN=""  # For app-only auth (public data)

# Kick — TBD
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""

# ============================================================
# UPSTASH REDIS — Rate limiting + caching
# ============================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================================
# INNGEST — Background job processing
# ============================================================
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ============================================================
# CLOUDFLARE R2 — File storage (avatars, media kit assets)
# ============================================================
# Account ID is shown in Cloudflare dashboard right-side panel
R2_ACCOUNT_ID=""
# From "Account API Tokens" → Object Read & Write, scoped to the bucket
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="twitchmetrics-uploads"
# Public r2.dev URL shown in bucket Settings → Public access
# Example: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=""

# ============================================================
# SENTRY — Error tracking
# ============================================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""   # For source map uploads (CI only)
SENTRY_ORG=""
SENTRY_PROJECT=""

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=""  # debug | info | warn | error (default: debug in dev, info in prod)

# ============================================================
# SECURITY
# ============================================================
# 32-byte hex key for AES-256-GCM OAuth token encryption
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# ============================================================
# LEGACY DATABASE — For historical data migration (Plan 4)
# ============================================================
# Connection string for the legacy TwitchMetrics database
LEGACY_DATABASE_URL=""

# ============================================================
# STRIPE — Payment processing for reports
# ============================================================
# Get keys from https://dashboard.stripe.com/apikeys
# Leave blank to use mock/test mode (no real payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ============================================================
# HUBSPOT — CRM sync for instant report purchases
# ============================================================
# Private App access token (client-provided). Leave blank to disable all
# HubSpot writes (recommended for local dev — the token targets the
# client's live portal).
HUBSPOT_ACCESS_TOKEN=""
# Pipeline/stage IDs default to the client's portal values
# (pipeline 725932936, Inbound Lead 1058694705, Purchased 1058694710);
# only set these to override per environment.
HUBSPOT_PIPELINE_ID=""
HUBSPOT_STAGE_INBOUND_LEAD=""
HUBSPOT_STAGE_PURCHASED=""
