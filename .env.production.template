# ============================================================
# DATABASE — Supabase PostgreSQL
# ============================================================
# Pooled connection via Supavisor (port 6543) — used for queries
DATABASE_URL=
# Direct connection (port 5432) — used for migrations only
DIRECT_URL=

# ============================================================
# AUTH — Auth.js v5 (NextAuth)
# ============================================================
# Production URL (e.g. https://twitchmetrics.net)
NEXTAUTH_URL=
# Secret for signing JWTs — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ============================================================
# SITE
# ============================================================
# Canonical site origin for sitemap, canonical URLs, and OG meta
# (e.g. https://twitchmetrics.net). Code falls back to
# https://twitchmetrics.net — set explicitly in production.
NEXT_PUBLIC_SITE_URL=

# ============================================================
# OAUTH PROVIDERS
# ============================================================

# Twitch — https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Shared secret for EventSub webhook HMAC verification
TWITCH_EVENTSUB_SECRET=

# Google / YouTube — https://console.cloud.google.com
# Enable: YouTube Data API v3 + YouTube Analytics API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-side API key for public YouTube data (no OAuth needed)
YOUTUBE_API_KEY=

# Instagram / Meta — https://developers.facebook.com
# Requires: Instagram Graph API + Business account linked to Facebook Page
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok — https://developers.tiktok.com
# Requires: Login Kit + Display API approval
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X / Twitter — https://developer.twitter.com
# Basic tier ($100/mo) minimum for read access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# App-only bearer token for public data reads
TWITTER_BEARER_TOKEN=

# Kick — API credentials (TBD)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ============================================================
# EXTERNAL SERVICES
# ============================================================

# Supabase — for Realtime features (future)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — REST-based Redis for rate limiting + caching
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest — background job processing
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Cloudflare R2 — file storage for banners, media kit assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=twitchmetrics-media
# Public URL for R2 bucket (e.g. https://media.twitchmetrics.net)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Sentry — error tracking and performance monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Auth token for source map uploads — CI/build only
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Resend — transactional email delivery
RESEND_API_KEY=

# ============================================================
# SECURITY
# ============================================================
# 32-byte hex key for AES-256-GCM OAuth token encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Site-wide HTTP Basic Auth gate (apps/web/src/middleware.ts). Setting a
# value enables it — any username is accepted, only the password is checked.
# MUST be unset (leave empty) at public launch: while set, the ENTIRE site
# (including robots.txt and sitemap) returns 401 to Google and other crawlers.
SITE_PASSWORD=

# ============================================================
# LOGGING
# ============================================================
# debug | info | warn | error (default: info in production)
LOG_LEVEL=info

# ============================================================
# AWS / DEPLOYMENT
# ============================================================
# AWS region for ECS, ECR, CloudWatch, etc.
AWS_REGION=us-east-1
# AWS account ID for ECR repository URI
AWS_ACCOUNT_ID=
# Docker image tag deployed to ECS (e.g. git SHA or semver)
IMAGE_TAG=
